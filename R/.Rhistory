"06_plot_waddington.R",
"07_report_and_export.R",
"07_survival_and_pk_analysis.R",
"08_master_pipeline.R",
"09_journal_themes_and_palettes.R",
"extract_tumor_signature.R",
"query_l1000_local.R"
)
# 3. 开始自动读取与文本拼接
cat(">>> 开始读取当前文件夹下的所有 R 脚本...\n")
combined_text <- c(
"# ==============================================================================",
"#  CellReprogramR Master Pipeline (Auto-Combined Version)",
"#  Generated Date: ", as.character(Sys.time()),
"# ==============================================================================\n\n"
)
found_cnt <- 0
for (f in r_files) {
f_path <- file.path(SCRIPT_DIR, f)
if (file.exists(f_path)) {
message("  └─ 成功读取: ", f)
found_cnt <- found_cnt + 1
# 读取单个文件内容
lines <- readLines(f_path, encoding = "UTF-8", warn = FALSE)
# 添加模块分界头
header <- c(
"\n\n# ", paste(rep("-", 78), collapse = ""),
paste0("# MODULE FILE: ", f),
paste("# ", paste(rep("-", 78), collapse = "")), "\n"
)
combined_text <- c(combined_text, header, lines)
} else {
warning("⚠️ 当前文件夹未找到文件: ", f)
}
}
# 4. 安全写入同级目录
if (found_cnt > 0) {
writeLines(combined_text, con = MERGED_OUTPUT_FILE, useBytes = FALSE)
cat("\n🎉 [成功] 已将", found_cnt, "个脚本文件合并为：\n👉", normalizePath(MERGED_OUTPUT_FILE), "\n")
} else {
stop("❌ 错误：在当前目录下未找到任何匹配的 .R 文件！请先确认 RStudio 的工作目录 (getwd()) 是否正确。")
}
