# ==============================================================================
#  CellReprogramR | 脑胶质瘤单细胞重编程全流程一键运行脚本 (Master Wrapper)
# ==============================================================================
# 2. 载入核心 R 包模块
suppressPackageStartupMessages({
library(Seurat)
library(data.table)
library(dplyr)
library(ggplot2)
library(arrow)
})
# 如果尚未安装为本地包，取消下方注释并 source 脚本：
# source("./R/01_phase_space.R")
# source("./R/02_l1000_query.R")
# source("./R/03_synergy_eval.R")
# source("./R/04_drug_simulation.R")
# source("./R/05_flow_waddington.R")
# source("./R/07_survival_and_pk_analysis.R")
# source("./R/08_master_pipeline.R")
# 3. 设置输入文件路径与输出目录 (修改为你存放数据的文件夹路径)
DATA_DIR <- "D:/Cell"            # 数据存放目录
OUT_DIR  <- "D:/Cell/Final_Results"   # 结果导出目录
# 4. 执行一键流水线
results <- run_reprogramming_pipeline(
# --- 基础数据配置 ---
rds_path          = file.path(DATA_DIR, "Glioma_CrossCohort_Annotated_CyclingTAMs_Final.rds"),
parquet_path      = file.path(DATA_DIR, "l1000_cns_matrix_fast.parquet"),
meta_parquet_path = file.path(DATA_DIR, "l1000_cns_meta.parquet"),
cell_type_col     = "CellType",
# --- 重编程细胞方向设置 ---
target_type       = "Oligodendrocyte",
source_types      = c("MES-like", "Astrocyte/AC-like", "NPC-like", "OPC-like"),
malig_types       = c("MES-like", "Astrocyte/AC-like"),
# --- 候选双药组合配置 ---
drug1             = "saracatinib",
drug2             = "lansoprazole",
alpha             = 0.5,
beta              = 0.5,
# --- 算法与并行计算参数 ---
n_perm            = 1000,
n_cores           = 8,
# --- 跨队列预后与生存分析模块 (已修正为真实文件名) ---
run_survival      = TRUE,
survival_paths    = list(
tcga_gbm      = file.path(DATA_DIR, "TCGA-GBM_mrna_expr_fpkm.csv"),
tcga_lgg      = file.path(DATA_DIR, "TCGA-LGG_mrna_expr_fpkm.csv"),
tcga_clin_gbm = file.path(DATA_DIR, "TCGA-GBM_clinicalSE.csv"),
tcga_clin_lgg = file.path(DATA_DIR, "TCGA-LGG_clinicalSE.csv"),
cgga_expr     = file.path(DATA_DIR, "CGGA.mRNAseq.txt"),
cgga_clin     = file.path(DATA_DIR, "CGGA.clinical.20200506.txt")
),
# --- 经典化疗药 PK 对比模块 ---
run_pk            = TRUE,
# --- 导出路径 ---
output_dir        = OUT_DIR
)
# ==============================================================================
# 🎨 补画并保存 2D UMAP 流场与 3D Waddington 势能山谷
# ==============================================================================
library(ggplot2)
library(plotly)
library(MASS)
OUT_DIR <- "D:/Cell/Final_Results"
dir.create(OUT_DIR, showWarnings = FALSE, recursive = TRUE)
# ------------------------------------------------------------------------------
# 1. 渲染并显示 2D UMAP 重编程矢量流场图
# ------------------------------------------------------------------------------
cat(">>> 正在补画 2D UMAP 流场图...\n")
p_2d <- plot_reprogramming_flow(
mc_meta = results$mc_meta,
flow_df = results$flow_df,
cell_type_col = "CellType"
)
names(results)
# ==============================================================================
# 🎨 针对 phase_space 结构精修：渲染并导出 2D UMAP 流场与 3D Waddington 势能图
# ==============================================================================
library(ggplot2)
library(dplyr)
OUT_DIR <- "D:/Cell/Final_Results"
dir.create(OUT_DIR, showWarnings = FALSE, recursive = TRUE)
# 1. 从 phase_space 中精准提取 mc_meta 数据框
if (is.data.frame(results$phase_space)) {
mc_meta <- results$phase_space
} else if (is.list(results$phase_space) && !is.null(results$phase_space$mc_meta)) {
mc_meta <- results$phase_space$mc_meta
} else if (is.list(results$phase_space) && !is.null(results$phase_space$meta)) {
mc_meta <- results$phase_space$meta
} else {
mc_meta <- results$phase_space[[1]]
}
flow_df <- results$flow_df
cat("✅ 成功提取 Metacell 节点数据 (", nrow(mc_meta), " 行)！\n")
# 2. 检查 cell_type 列名 (兼容 CellType, cell_type, State 等)
type_col <- intersect(c("CellType", "cell_type", "State", "Cluster"), colnames(mc_meta))[1]
if (is.na(type_col)) type_col <- colnames(mc_meta)[2]
# ------------------------------------------------------------------------------
# 3. 渲染并显示 2D UMAP 重编程矢量流场图
# ------------------------------------------------------------------------------
cat(">>> 正在渲染 2D UMAP 重编程流场图...\n")
p_2d <- plot_reprogramming_flow(
mc_meta = mc_meta,
flow_df = flow_df,
cell_type_col = type_col
)
# 屏幕上绘制展示
print(p_2d)
# 高清导出 PDF & PNG
ggsave(file.path(OUT_DIR, "Fig1_2D_Reprogramming_Flow.pdf"), p_2d, width = 8, height = 6.5)
ggsave(file.path(OUT_DIR, "Fig1_2D_Reprogramming_Flow.png"), p_2d, width = 8, height = 6.5, dpi = 300)
cat("🎉 2D 流场图导出成功: ", file.path(OUT_DIR, "Fig1_2D_Reprogramming_Flow.pdf"), "\n")
# ------------------------------------------------------------------------------
# 4. 渲染 3D Waddington 势能山谷网页交互图 (plotly)
# ------------------------------------------------------------------------------
u1_col <- grep("UMAP_1|umap_1|UMAP1", colnames(mc_meta), value = TRUE)[1]
u2_col <- grep("UMAP_2|umap_2|UMAP2", colnames(mc_meta), value = TRUE)[1]
if (!is.na(u1_col) && !is.na(u2_col) && requireNamespace("plotly", quietly = TRUE) && requireNamespace("MASS", quietly = TRUE)) {
cat(">>> 正在计算 3D Waddington 势能山谷...\n")
# 核密度估计拟合势能井
dens <- MASS::kde2d(x = mc_meta[[u1_col]], y = mc_meta[[u2_col]], n = 100)
p_3d <- plotly::plot_ly(x = ~dens$x, y = ~dens$y, z = ~(-dens$z)) %>%
plotly::add_surface(
colorscale = "Viridis",
contours = list(z = list(show = TRUE, usecolormap = TRUE, project = list(z = TRUE)))
) %>%
plotly::layout(
title = "3D Waddington Energy Landscape Simulation",
scene = list(
xaxis = list(title = "UMAP 1"),
yaxis = list(title = "UMAP 2"),
zaxis = list(title = "Relative Energy Potential")
)
)
# 在 RStudio Viewer 展现
print(p_3d)
# 保存为交互网页 (.html)
htmlwidgets::saveWidget(p_3d, file = file.path(OUT_DIR, "Fig2_3D_Waddington_Landscape.html"), selfcontained = TRUE)
cat("🎉 3D Waddington 势能山谷交互图导出成功: ", file.path(OUT_DIR, "Fig2_3D_Waddington_Landscape.html"), "\n")
}
