# 👑 神奇的 "auto" 模式：脚本会自己把几十万组数据算一遍，然后提取最强的两个药！
drug1             = "auto",
drug2             = "auto",
alpha             = 0.5,
beta              = 0.5,
n_perm            = 1000,
