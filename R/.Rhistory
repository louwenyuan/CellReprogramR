# ==============================================================================
#  CellReprogramR | 自动合并所有子模块为连贯 Master 脚本 (适配实际目录版)
# ==============================================================================
# 1. 设置绝对路径
SCRIPT_DIR <- "D:/Cell/CellReprogramR/R"
MERGED_OUTPUT_FILE <- file.path(SCRIPT_DIR, "00_MASTER_ALL_PIPELINE_COMBINED.R")
# 2. 检查路径是否存在
if (!dir.exists(SCRIPT_DIR)) {
stop("❌ 未找到目录：", SCRIPT_DIR, "，请确认盘符和文件夹名称是否正确！")
}
# 3. 按依赖关系与逻辑拓扑顺序排列的文件列表 (结合截图已纠正 03_query_l1000.R)
r_files_ordered <- c(
"main_functions.R",                 # 1. 通用基础函数/辅助工具
"09_journal_themes_and_palettes.R", # 2. 期刊级绘图主题与配色盘
"00_inspect_dataset.R",             # 3. 数据集质控与初步检验
"extract_tumor_signature.R",        # 4. 肿瘤特征提取
"01_build_metacells.R",             # 5. Metacell 构建
"01_extract_signatures.R",          # 6. 特征提取与转化
"02_eval_synergy.R",                # 7. 协同性评估
"03_query_l1000.R",                 # 8. L1000 本地查询 (修正原 query_l1000_local.R)
"03_predict_flow.R",                # 9. 相场与流转预测
"04_simulate_combo.R",              # 10. 双药矢量叠加模拟
"05_plot_flow.R",                   # 11. 向量场可视化
"06_plot_waddington.R",             # 12. 沃丁顿景观地貌绘图
"07_report_and_export.R",           # 13. 终端报告与 Excel 导出
"07_survival_and_pk_analysis.R",    # 14. 临床生存分析与 PK 药代动力学
"08_master_pipeline.R"              # 15. 主管道集成入口
)
# 4. 检查文件夹中是否有未在列表中列出的 extra .R 文件，防止漏掉
all_dir_r_files <- list.files(SCRIPT_DIR, pattern = "\\.[Rr]$", full.names = FALSE)
output_filename <- basename(MERGED_OUTPUT_FILE)
# 排除目标输出文件本身
all_dir_r_files <- setdiff(all_dir_r_files, output_filename)
# 检查缺失与新增
missing_files <- setdiff(r_files_ordered, all_dir_r_files)
extra_files   <- setdiff(all_dir_r_files, r_files_ordered)
if (length(missing_files) > 0) {
warning("⚠️ 预设列表中有文件未在文件夹中找到: ", paste(missing_files, collapse = ", "))
}
# 最终合并文件顺序：预设顺序文件 + 额外遗漏文件
final_file_list <- c(intersect(r_files_ordered, all_dir_r_files), extra_files)
# 5. 开始读取与拼接
cat(">>> 开始从 [", SCRIPT_DIR, "] 读取并按拓扑顺序合并脚本...\n\n")
combined_text <- c(
"# ==============================================================================",
"#  CellReprogramR Master Pipeline (Auto-Combined Version)",
"#  Generated Date: ", as.character(Sys.time()),
"#  Target File: ", MERGED_OUTPUT_FILE,
"# ==============================================================================\n\n"
)
found_cnt <- 0
for (f in final_file_list) {
f_path <- file.path(SCRIPT_DIR, f)
if (file.exists(f_path)) {
message("  └─ 成功读取: ", f)
found_cnt <- found_cnt + 1
# 兼容编码读取文本
lines <- tryCatch({
readLines(f_path, encoding = "UTF-8", warn = FALSE)
}, error = function(e) {
readLines(f_path, warn = FALSE)
})
# 插入模块分割标记 Header
header <- c(
"\n\n# ", paste(rep("-", 78), collapse = ""),
paste0("# MODULE FILE: ", f),
paste("# ", paste(rep("-", 78), collapse = "")), "\n"
)
combined_text <- c(combined_text, header, lines)
}
}
# 6. 安全写入合并后的 Master 文件
if (found_cnt > 0) {
writeLines(combined_text, con = MERGED_OUTPUT_FILE, useBytes = FALSE)
cat("\n🎉 [合并成功] 已按科学依赖关系将", found_cnt, "个脚本文件合并生成为：\n👉", MERGED_OUTPUT_FILE, "\n")
} else {
stop("❌ 错误：在该目录下未找到任何可读的 .R 文件！")
}
results <- run_cellreprogramr_pipeline(rds_path = "Glioma_CrossCohort_Annotated_CyclingTAMs_Final.rds", out_dir = "./Output_CyclingTAMs")
